# Copia este archivo como .env.local y completa los valores.
# Con Supabase local, ejecuta `npx supabase status` y copia:
#   API URL          -> VITE_SUPABASE_URL
#   Publishable key  -> VITE_SUPABASE_PUBLISHABLE_KEY  (en versiones antiguas: "anon key")
#
# Solo van aquí claves PÚBLICAS. La service_role / secret key NUNCA debe tener
# el prefijo VITE_ porque Vite la incluiría en el código que llega al navegador.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
